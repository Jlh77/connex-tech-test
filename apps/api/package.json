{
  "name": "@connex-tech-test/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "rm -rf ../../dist/apps/api && tsc --project tsconfig.app.json && tsc-alias --project tsconfig.app.json"
          ],
          "cwd": "apps/api"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "nodemon --config apps/api/nodemon.json"
        }
      },
      "start": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node dist/apps/api/main.js"
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
